NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_AMPLITUDE_SERVER_ZONE=US
NEXT_PUBLIC_AMPLITUDE_SESSION_REPLAY_RATE=1

# Use "preview" while the backend is unavailable and "stripe" in production.
NEXT_PUBLIC_PAYMENTS_MODE=preview
NEXT_PUBLIC_PAYMENTS_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend-only Stripe values. Configure them in the backend secret store.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ESSENTIAL=price_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_COMPLETE=price_...
